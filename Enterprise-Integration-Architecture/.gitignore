# Learner submissions (keep structure via .gitkeep)
submissions/**/*
!submissions/**/.gitkeep

# Secrets and local env
.env
.env.*
!.env.example
*.pem
*.key
credentials.json

# AWS / Terraform
**/.build/
.terraform/
*.tfstate
*.tfstate.*
crash.log
.demo/
.lab/
.venv/
terraform.tfvars
!terraform.tfvars.example
!**/*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# OS / IDE
.DS_Store
.idea/
.vscode/
*.swp

# Python / Node artifacts
.pytest_cache/
htmlcov/
.coverage
__pycache__/
*.pyc
node_modules/
dist/
*.zip

# Course UI local progress is in localStorage; ignore accidental dumps
course-ui/progress.local.json
