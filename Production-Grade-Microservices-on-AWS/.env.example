# Local development
USER_SERVICE_URL=http://user-service:8001
PRODUCT_SERVICE_URL=http://product-service:8002
ORDER_SERVICE_URL=http://order-service:8003
NOTIFICATION_SERVICE_URL=http://notification-service:8004

# JWT (change in production)
JWT_SECRET=change-me-in-production-use-secrets-manager
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Database (local SQLite paths inside containers)
USER_DATABASE_URL=sqlite:////data/users.db
PRODUCT_DATABASE_URL=sqlite:////data/products.db
ORDER_DATABASE_URL=sqlite:////data/orders.db

# Events: local HTTP fan-out (Module 5+)
EVENT_PUBLISH_MODE=http
EVENT_HTTP_ENDPOINT=http://notification-service:8004/events

# AWS (Module 4+ — leave empty for local-only)
AWS_REGION=us-east-1
EVENT_BUS_NAME=
DYNAMODB_TABLE_PREFIX=

# Observability
LOG_LEVEL=INFO
ENABLE_XRAY=false
