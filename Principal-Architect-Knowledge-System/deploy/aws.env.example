# Copy to deploy/aws.env and fill in after running: make aws-setup
# deploy/aws.env is gitignored — never commit secrets.

AWS_REGION=us-west-2
AWS_STACK_NAME=principal-architect-ks-prod

# Set automatically by scripts/setup-aws-infrastructure.sh:
S3_BUCKET=
CLOUDFRONT_DISTRIBUTION_ID=
SITE_URL=
CLOUDFRONT_URL=

# Optional — set by scripts/setup-custom-domain.sh (BayLearn-style branded URL):
# CUSTOM_DOMAIN=paks.bayareala8s.com
# ACM_CERTIFICATE_ARN=arn:aws:acm:us-east-1:ACCOUNT:certificate/...
# ROUTE53_HOSTED_ZONE_ID=Z0123456789ABC
