        <mxCell id="retry_rule" value="RETRY when:&amp;#10;• Bedrock throttling&amp;#10;• Lambda timeout&amp;#10;• Transient network error&amp;#10;&amp;#10;Use exponential backoff, max 3 attempts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#879196;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="580" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="catch_rule" value="CATCH when:&amp;#10;• Validation permanent fail&amp;#10;• Invalid enum / schema&amp;#10;• Business rule violation&amp;#10;&amp;#10;→ deterministic fallback state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#879196;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="480" y="580" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="idempotent" value="IDEMPOTENCY KEY&amp;#10;Use correlation_id as DynamoDB key.&amp;#10;Replay safe — same input → same row, no duplicates." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=#232F3E;align=left;verticalAlign=top;fontSize=9;fontFamily=Courier New;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
