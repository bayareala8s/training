        <mxCell id="focus" value="YOUR GOAL&amp;#10;Understand when Step Functions retries vs catches, and why persist must be idempotent." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#527FFF;align=left;verticalAlign=top;fontSize=11;fontStyle=1;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
