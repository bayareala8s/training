        <mxCell id="do_80_720" value="DO THIS&amp;#10;Open Step Functions console → Executions.&amp;#10;Inject failure in lab, screenshot run graph." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F7EF;strokeColor=#248814;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
