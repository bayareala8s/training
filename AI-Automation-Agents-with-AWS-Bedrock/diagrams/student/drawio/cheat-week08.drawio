        <mxCell id="demo" value="5-MIN DEMO SCRIPT&amp;#10;0:00 — Problem statement (30s)&amp;#10;0:30 — Architecture walkthrough (1m)&amp;#10;1:30 — Happy path live call (1.5m)&amp;#10;3:00 — Show validation failure + recovery (1m)&amp;#10;4:00 — Audit trail + governance (1m)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=#232F3E;align=left;verticalAlign=top;fontSize=9;fontFamily=Courier New;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
