        <mxCell id="minbar" value="MINIMUM BAR&amp;#10;☐ Working deploy (start.sh or SAM deploy)&amp;#10;☐ At least 1 API endpoint live&amp;#10;☐ Structured output + validation&amp;#10;☐ Step Functions OR agent routing&amp;#10;☐ Audit log with correlation_id&amp;#10;☐ README with architecture + run steps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F7EF;strokeColor=#248814;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
