        <mxCell id="tree" value="CONFIDENCE GATE&amp;#10;&amp;#10;        ┌─ confidence ≥ 0.7 ─→ auto-route&amp;#10;output ─┤&amp;#10;        ├─ 0.4 ≤ conf &amp;lt; 0.7 ─→ route + flag review&amp;#10;        └─ confidence &amp;lt; 0.4 ─→ deterministic fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F7EF;strokeColor=#248814;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
