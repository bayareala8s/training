        <mxCell id="validate" value="VALIDATOR CHECKS&amp;#10;☐ Valid JSON (strict parse)&amp;#10;☐ All required keys present&amp;#10;☐ Types match (str, float)&amp;#10;☐ Enums in allowed set&amp;#10;☐ confidence in [0, 1]&amp;#10;☐ reason length ≤ max" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#879196;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
