        <mxCell id="schema" value="REQUIRED SCHEMA&amp;#10;label     → enum (billing|incident|general)&amp;#10;confidence → float 0.0–1.0&amp;#10;route     → enum (team_billing|team_ops|team_general)&amp;#10;reason    → string, max 120 chars" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=#232F3E;align=left;verticalAlign=top;fontSize=9;fontFamily=Courier New;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
