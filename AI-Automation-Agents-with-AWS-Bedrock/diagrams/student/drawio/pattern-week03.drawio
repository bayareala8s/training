        <mxCell id="101" value="Week 3 — Anti-Pattern vs Production Pattern" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1420" height="36" as="geometry" />
