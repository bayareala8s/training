        <mxCell id="102" value="Raw LLM output vs validated structured automation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#565656;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1420" height="28" as="geometry" />
        </mxCell>
        <mxCell id="z_bad" value="ANTI-PATTERN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#879196;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#232F3E;align=left;spacingLeft=12;spacingTop=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="176" width="680" height="420" as="geometry" />
        </mxCell>
        <mxCell id="z_good" value="PRODUCTION PATTERN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F7EF;strokeColor=#879196;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#232F3E;align=left;spacingLeft=12;spacingTop=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="176" width="680" height="420" as="geometry" />
        </mxCell>
        <mxCell id="focus" value="YOUR GOAL&amp;#10;See why validation is non-optional in enterprise automation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#527FFF;align=left;verticalAlign=top;fontSize=11;fontStyle=1;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="78" width="1420" height="60" as="geometry" />
        </mxCell>
        <mxCell id="bad1" value="User text → Bedrock → parse with regex → hope it works&amp;#10;&amp;#10;Risks:&amp;#10;• Model returns prose, not JSON&amp;#10;• Hallucinated enum values&amp;#10;• No confidence gate&amp;#10;• Downstream crashes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#DD3522;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="640" height="130" as="geometry" />
        </mxCell>
        <mxCell id="bad2" value="Example bad output:&amp;#10;&amp;quot;I think this is probably billing related...&amp;quot;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=#232F3E;align=left;verticalAlign=top;fontSize=9;fontFamily=Courier New;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="640" height="70" as="geometry" />
        </mxCell>
        <mxCell id="good1" value="User text → Bedrock → strict JSON → validator → confidence gate → route&amp;#10;&amp;#10;Controls:&amp;#10;• Schema enforced&amp;#10;• Fallback on failure&amp;#10;• correlation_id traced&amp;#10;• Tests cover 6 failure modes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F7EF;strokeColor=#248814;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="220" width="640" height="130" as="geometry" />
        </mxCell>
        <mxCell id="good2" value="Example good output:&amp;#10;{&amp;quot;label&amp;quot;:&amp;quot;billing&amp;quot;,&amp;quot;confidence&amp;quot;:0.91,&amp;#10; &amp;quot;route&amp;quot;:&amp;quot;team_billing&amp;quot;,&amp;quot;reason&amp;quot;:&amp;quot;invoice keyword&amp;quot;}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=#232F3E;align=left;verticalAlign=top;fontSize=9;fontFamily=Courier New;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="800" y="380" width="640" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rem_60_620" value="REMEMBER&amp;#10;If you cannot validate it, you cannot automate it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#8C4FFF;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="640" height="72" as="geometry" />
        </mxCell>
        <mxCell id="do_800_620" value="DO THIS&amp;#10;Implement validator before tuning prompts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F7EF;strokeColor=#248814;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="620" width="640" height="72" as="geometry" />
        </mxCell>
