        <mxCell id="obj" value="LEARNING FOCUS&amp;#10;Design IAM so only the runtime role can invoke specific foundation models. Enable model access, version prompts, and log metadata — not secrets." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#527FFF;align=left;verticalAlign=top;fontSize=11;fontStyle=1;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
