  <diagram id="04-week03" name="Week 3 — AI Decision Engine" compressed="false">
    <mxGraphModel dx="1600" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1200">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="101" value="Week 3 — AI Decision Engine" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="40" y="16" width="1620" height="36" as="geometry" />
        </mxCell>
        <mxCell id="102" value="Structured JSON outputs, schema validation, confidence gates, hybrid rules + AI" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=12;fontColor=#565656;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1620" height="28" as="geometry" />
        </mxCell>
        <mxCell id="obj" value="LEARNING FOCUS&amp;#10;Treat the LLM as a probabilistic component. Enforce JSON schema, reject bad outputs, and route low-confidence results to human review." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#527FFF;align=left;verticalAlign=top;fontSize=11;fontStyle=1;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="78" width="1520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="schema" value="REQUIRED JSON SCHEMA&amp;#10;{&amp;#10;  &amp;quot;label&amp;quot;: &amp;quot;billing|technical|security|general|unknown&amp;quot;,&amp;#10;  &amp;quot;confidence&amp;quot;: 0.0-1.0,&amp;#10;  &amp;quot;reason&amp;quot;: &amp;quot;max 200 chars&amp;quot;&amp;#10;}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=#232F3E;align=left;verticalAlign=top;fontSize=9;fontFamily=Courier New;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="fail" value="FAILURE MODES (discuss in class)&amp;#10;• Non-JSON text&amp;#10;• Missing keys&amp;#10;• Invalid enum value&amp;#10;• confidence out of range&amp;#10;• reason too long" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#DD3522;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="520" width="320" height="130" as="geometry" />
        </mxCell>
        <mxCell id="hybrid" value="HYBRID PATTERN&amp;#10;Rules handle 30-40% obvious cases → cheaper, faster, auditable.&amp;#10;LLM handles ambiguous language only." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9F7EF;strokeColor=#248814;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="800" y="520" width="380" height="90" as="geometry" />
        </mxCell>
        <mxCell id="inst_60_680" value="INSTRUCTOR TALKING POINT&amp;#10;Demo: show valid JSON pass, then malformed output hitting fallback. Students must explain WHY validation is not optional." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#FFB800;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="680" width="520" height="90" as="geometry" />
        </mxCell>
        <mxCell id="stu_600_680" value="STUDENT TAKEAWAY&amp;#10;Downstream automation only consumes validated objects — never raw model text." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#8C4FFF;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
