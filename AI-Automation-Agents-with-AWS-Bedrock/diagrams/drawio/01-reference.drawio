        <mxCell id="inst_1280_720" value="INSTRUCTOR TALKING POINT&amp;#10;Stress: Bedrock is probabilistic — orchestration + validation make automation safe. Never let the model call external systems without policy checks." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#FFB800;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
