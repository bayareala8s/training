        <mxCell id="code_in" value="Example input:&amp;#10;{ &amp;quot;text&amp;quot;: &amp;quot;invoice charged twice&amp;quot;,&amp;#10;  &amp;quot;correlation_id&amp;quot;: &amp;quot;abc-123&amp;quot; }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=#232F3E;align=left;verticalAlign=top;fontSize=9;fontFamily=Courier New;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
