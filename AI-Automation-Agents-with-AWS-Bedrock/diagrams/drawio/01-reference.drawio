        <mxCell id="obj" value="LEARNING FOCUS&amp;#10;Understand how events and APIs enter the system, how Bedrock is invoked inside orchestrated workflows, and where validation, persistence, audit, and human oversight fit." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#527FFF;align=left;verticalAlign=top;fontSize=11;fontStyle=1;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
