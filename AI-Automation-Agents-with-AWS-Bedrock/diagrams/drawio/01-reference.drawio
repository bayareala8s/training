        <mxCell id="code_out" value="Validated output:&amp;#10;{ &amp;quot;label&amp;quot;: &amp;quot;billing&amp;quot;, &amp;quot;confidence&amp;quot;: 0.91,&amp;#10;  &amp;quot;route&amp;quot;: &amp;quot;team_billing&amp;quot; }" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=#232F3E;align=left;verticalAlign=top;fontSize=9;fontFamily=Courier New;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
