        <mxCell id="legend" value="LEGEND&amp;#10;• Solid arrow = happy path&amp;#10;• Dashed red = fallback / human&amp;#10;• correlation_id in every log + audit row" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
