        </mxCell>
        <mxCell id="zl" value="LARGE LANGUAGE MODELS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F0FF;strokeColor=#879196;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#232F3E;align=left;spacingLeft=12;spacingTop=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1120" y="186" width="540" height="340" as="geometry" />
        </mxCell>
        <mxCell id="zc" value="THIS COURSE — Production AI Automation Platform" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#879196;verticalAlign=top;fontSize=12;fontStyle=1;fontColor=#232F3E;align=left;spacingLeft=12;spacingTop=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="556" width="1620" height="280" as="geometry" />
        </mxCell>
        <mxCell id="obj" value="LEARNING FOCUS&amp;#10;Compare rules engines, traditional ML, and LLMs. Identify risks (hallucination, cost, data leakage) and map them to architectural controls." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F4FD;strokeColor=#527FFF;align=left;verticalAlign=top;fontSize=11;fontStyle=1;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="78" width="1520" height="70" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="Best for:&amp;#10;• Fixed policy logic&amp;#10;• Compliance checks&amp;#10;• Known patterns&amp;#10;&amp;#10;Limitations:&amp;#10;• Breaks on free text&amp;#10;• Hard to maintain huge rule sets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#879196;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="60" y="220" width="220" height="160" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="Example:&amp;#10;IF keyword IN ('invoice','billing')&amp;#10;  THEN route = 'billing'" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;strokeColor=#232F3E;align=left;verticalAlign=top;fontSize=9;fontFamily=Courier New;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="220" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="Best for:&amp;#10;• Classification with labels&amp;#10;• Forecasting&amp;#10;• Vision / tabular data&amp;#10;&amp;#10;Limitations:&amp;#10;• Needs training data&amp;#10;• Drift when data changes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#879196;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="600" y="220" width="220" height="160" as="geometry" />
        </mxCell>
        <mxCell id="l1" value="Best for:&amp;#10;• Language understanding&amp;#10;• Summarization&amp;#10;• Flexible reasoning&amp;#10;&amp;#10;Limitations:&amp;#10;• Non-deterministic&amp;#10;• Can hallucinate&amp;#10;• Token cost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#879196;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="1140" y="220" width="240" height="160" as="geometry" />
        </mxCell>
        <mxCell id="risk" value="ENTERPRISE RISKS&amp;#10;① Hallucination → validation + human review&amp;#10;② Cost spikes → throttling + limits&amp;#10;③ Data leakage → redaction + IAM&amp;#10;④ No audit trail → correlation ID + logging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FADBD8;strokeColor=#DD3522;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="860" width="500" height="120" as="geometry" />
        </mxCell>
        <mxCell id="inst_580_860" value="INSTRUCTOR TALKING POINT&amp;#10;Use the decision matrix in class: deterministic? → rules. Labeled data + stability? → ML. Language + flexibility? → LLM + guardrails." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF8E6;strokeColor=#FFB800;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="580" y="860" width="480" height="90" as="geometry" />
        </mxCell>
        <mxCell id="stu_1100_860" value="STUDENT TAKEAWAY&amp;#10;AI in production = workflow + model + validation + ops — not chatbot-only prompt engineering." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#8C4FFF;align=left;verticalAlign=top;fontSize=10;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
