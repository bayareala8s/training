{
  "dataset": "retail/orders",
  "version": "1.0",
  "rules": [
    {
      "name": "order_id_not_null",
      "field": "order_id",
      "type": "not_null",
      "severity": "error",
      "message": "order_id is required"
    },
    {
      "name": "amount_in_range",
      "field": "order_amount",
      "type": "range",
      "params": { "min": 0.01, "max": 50000 },
      "severity": "error",
      "message": "order_amount must be between 0.01 and 50000"
    },
    {
      "name": "status_valid",
      "field": "status",
      "type": "enum",
      "params": {
        "values": ["pending", "shipped", "delivered", "cancelled"]
      },
      "severity": "error"
    },
    {
      "name": "email_format",
      "field": "customer_email",
      "type": "regex",
      "params": {
        "pattern": "^[\\w.+-]+@[\\w.-]+\\.[a-zA-Z]{2,}$"
      },
      "severity": "warning",
      "message": "customer_email must be a valid email address"
    }
  ]
}
