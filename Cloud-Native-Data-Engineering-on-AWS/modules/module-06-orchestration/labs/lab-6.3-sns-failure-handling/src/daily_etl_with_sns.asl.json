{
  "Comment": "Lab 6.3 — Failure handling with SNS notifications",
  "StartAt": "StartGlueETL",
  "States": {
    "StartGlueETL": {
      "Type": "Task",
      "Resource": "arn:aws:states:::glue:startJobRun.sync",
      "Parameters": {
        "JobName": "${GLUE_JOB_NAME}",
        "Arguments": {
          "--processing_date.$": "$.processing_date",
          "--dataset_path.$": "$.dataset"
        }
      },
      "Retry": [
        {
          "ErrorEquals": ["Glue.ThrottlingException"],
          "IntervalSeconds": 30,
          "MaxAttempts": 3,
          "BackoffRate": 2.0
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "PrepareFailureNotification"
        }
      ],
      "ResultPath": "$.glue",
      "Next": "RunQualityCheck"
    },
    "RunQualityCheck": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${VALIDATION_LAMBDA_ARN}",
        "Payload": {
          "action": "run_quality_check",
          "processing_date.$": "$.processing_date",
          "dataset.$": "$.dataset"
        }
      },
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "PrepareFailureNotification"
        }
      ],
      "ResultPath": "$.quality_result",
      "Next": "EvaluateQuality"
    },
    "EvaluateQuality": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.quality_result.Payload.pass_rate",
          "NumericGreaterThanEquals": 99.9,
          "Next": "PrepareSuccessNotification"
        }
      ],
      "Default": "PrepareFailureNotification"
    },
    "PrepareSuccessNotification": {
      "Type": "Pass",
      "Parameters": {
        "pipeline": "retail-daily-etl",
        "status": "SUCCEEDED",
        "processing_date.$": "$.processing_date",
        "pass_rate.$": "$.quality_result.Payload.pass_rate",
        "execution_id.$": "$$.Execution.Name"
      },
      "ResultPath": "$.notification",
      "Next": "NotifySuccess"
    },
    "PrepareFailureNotification": {
      "Type": "Pass",
      "Parameters": {
        "pipeline": "retail-daily-etl",
        "status": "FAILED",
        "processing_date.$": "$.processing_date",
        "failed_state.$": "$$.State.Name",
        "error.$": "$.error",
        "pass_rate.$": "$.quality_result.Payload.pass_rate",
        "execution_id.$": "$$.Execution.Name"
      },
      "ResultPath": "$.notification",
      "Next": "NotifyFailure"
    },
    "NotifySuccess": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${SNS_TOPIC_ARN}",
        "Subject": "[RetailCo] Daily ETL SUCCEEDED",
        "Message.$": "States.JsonToString($.notification)"
      },
      "Next": "PipelineSucceeded"
    },
    "NotifyFailure": {
      "Type": "Task",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${SNS_TOPIC_ARN}",
        "Subject": "[RetailCo] Daily ETL FAILED",
        "Message.$": "States.JsonToString($.notification)"
      },
      "Next": "PipelineFailed"
    },
    "PipelineSucceeded": {
      "Type": "Succeed"
    },
    "PipelineFailed": {
      "Type": "Fail",
      "Error": "PipelineFailed",
      "Cause": "Quality SLO not met or upstream task failed — see SNS alert"
    }
  }
}
