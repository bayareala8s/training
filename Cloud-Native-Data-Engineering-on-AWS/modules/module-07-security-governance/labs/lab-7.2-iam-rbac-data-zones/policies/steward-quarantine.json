{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListQuarantine",
      "Effect": "Allow",
      "Action": ["s3:ListBucket"],
      "Resource": "arn:aws:s3:::BUCKET_NAME",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["quarantine/*"]
        }
      }
    },
    {
      "Sid": "ReadWriteQuarantine",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::BUCKET_NAME/quarantine/*"
    },
    {
      "Sid": "ReadCleanedForReplay",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::BUCKET_NAME/cleaned/*"
    },
    {
      "Sid": "WriteCleanedReplayOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::BUCKET_NAME/cleaned/*"
    },
    {
      "Sid": "DenyRawAndCurated",
      "Effect": "Deny",
      "Action": ["s3:GetObject"],
      "Resource": [
        "arn:aws:s3:::BUCKET_NAME/raw/*",
        "arn:aws:s3:::BUCKET_NAME/curated/*"
      ]
    }
  ]
}
