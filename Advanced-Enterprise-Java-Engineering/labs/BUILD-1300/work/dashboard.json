      "id": 102,
      "title": "SLO — 99.9% payment create (not 99.99%)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "aeje-prom-paper" },
      "description": "SLI = successful POST / (successful + server failures). Server failure = 5xx or timeout-as-5xx. Exclude ordinary 4xx. Target 99.9% — ARCHITECT-1401 owns 99.99%.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 0.999 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 19 },
      "id": 7,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "expr": "1 - (sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/payments\",method=\"POST\",status=~\"5..\"}[30d])) / sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/payments\",method=\"POST\"}[30d])))",
          "legendFormat": "30d SLI",
          "refId": "A"
        }
      ],
      "title": "SLI / SLO 99.9% — 30d rolling",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "aeje-prom-paper" },
      "description": "Error budget ~43 minutes / 30d at 99.9%. Fast 1h and slow 6h burn. Page on SLO burn, not CPU>80%.",
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 19 },
      "id": 8,
      "targets": [
        {
          "expr": "(sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/payments\",method=\"POST\",status=~\"5..\"}[1h])) / sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/payments\",method=\"POST\"}[1h]))) / 0.001",
          "legendFormat": "fast burn 1h (budget=0.1%)",
          "refId": "A"
        },
        {
          "expr": "(sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/payments\",method=\"POST\",status=~\"5..\"}[6h])) / sum(rate(http_server_requests_seconds_count{uri=\"/api/v1/payments\",method=\"POST\"}[6h]))) / 0.001",
          "legendFormat": "slow burn 6h (budget=0.1%)",
          "refId": "B"
        }
