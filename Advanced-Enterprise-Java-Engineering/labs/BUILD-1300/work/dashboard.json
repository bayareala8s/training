          "range": true,
          "refId": "A"
        }
      ],
      "title": "Errors — 5xx POST /api/v1/payments",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "aeje-prom-paper" },
      "description": "Teaching tail is P99 of the histogram, not average, not P50-only. Latency SLO: P99 < 400ms on happy path.",
