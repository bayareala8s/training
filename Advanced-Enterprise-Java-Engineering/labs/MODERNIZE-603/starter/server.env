# MODERNIZE-603 — payment replica topology (synthetic BayPay).
# Operators inject BAYPAY_DB_PASSWORD at runtime (export, secret store, or platform env).
# Do not commit a password value.

BAYPAY_DB_HOST=db-east.baypay.example
BAYPAY_DB_PORT=5432
BAYPAY_DB_NAME=baypay
BAYPAY_DB_USER=baypay_app

# ND contrast (lab task 7):
# baypayDbAlias lived in the BayPayCell master repository as a J2C auth alias Morgan typed in the admin console.
# A cell console is still a secret store with a GUI — rotation and audit stay on whoever has dmgr-east, not 12-factor.
# Boot application-prod.yml already interpolates BAYPAY_DB_USER / BAYPAY_DB_PASSWORD; Liberty now uses the same keys via ${env.BAYPAY_DB_*}.
