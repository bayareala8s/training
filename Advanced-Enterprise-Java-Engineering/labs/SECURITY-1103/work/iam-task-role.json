{
  "RoleName": "baypay-1103-task",
  "Description": "Task role: what the payment JVM becomes. No GetSecretValue — ECS injects env via the execution role. No AdministratorAccess.",
  "AssumeRolePolicyDocument": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "EcsTasksAssume",
        "Effect": "Allow",
        "Principal": {
          "Service": "ecs-tasks.amazonaws.com"
        },
        "Action": "sts:AssumeRole"
      }
    ]
  }
}
