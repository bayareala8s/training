{
  "RoleName": "baypay-1103-execution",
  "Description": "ECS execution role: pull ECR, write logs, read one secret, decrypt one CMK. Not the JVM.",
  "AssumeRolePolicyDocument": {
    "Version": "2012-10-17",
    "Statement": [
      {
        "Sid": "EcsTasksAssume",
        "Effect": "Allow",
        "Principal": {
          "Service": "ecs-tasks.amazonaws.com"
        },
        "Action": "sts:AssumeRole"
      }
    ]
  },
  "Policies": [
    {
      "PolicyName": "baypay-1103-execution-least",
      "PolicyDocument": {
        "Version": "2012-10-17",
        "Statement": [
          {
            "Sid": "EcrAuth",
            "Effect": "Allow",
            "Action": "ecr:GetAuthorizationToken",
            "Resource": "*"
          },
          {
            "Sid": "EcrPullPayment",
            "Effect": "Allow",
            "Action": [
              "ecr:BatchCheckLayerAvailability",
              "ecr:GetDownloadUrlForLayer",
              "ecr:BatchGetImage"
            ],
            "Resource": "arn:aws:ecr:us-west-2:123456789012:repository/baypay/payment-service"
          },
          {
            "Sid": "LogsPayment",
            "Effect": "Allow",
            "Action": [
              "logs:CreateLogStream",
              "logs:PutLogEvents"
            ],
            "Resource": "arn:aws:logs:us-west-2:123456789012:log-group:/ecs/baypay-1103/payment-service:*"
          },
          {
            "Sid": "OneSecret",
            "Effect": "Allow",
            "Action": "secretsmanager:GetSecretValue",
            "Resource": "arn:aws:secretsmanager:us-west-2:123456789012:secret:baypay/payment/db*"
          },
          {
            "Sid": "OneCmk",
            "Effect": "Allow",
            "Action": [
              "kms:Decrypt",
              "kms:DescribeKey"
            ],
            "Resource": "arn:aws:kms:us-west-2:123456789012:key/12345678-1103-4000-8000-baypaykms0001"
          }
        ]
      }
    }
  ]
}
