<?xml version="1.0" encoding="UTF-8"?>
<server description="BayPay payment — MODERNIZE-602 starter (intentionally incomplete)">

    <!--
      Defects you must fix (do not treat this file as production):
      - featureManager is missing jdbc-4.3, jndi-1.0, and persistence-3.1
      - DataSource still uses cell-wide jdbc/baypay
      - server.env is incomplete; wire ${env.BAYPAY_DB_*} and isolated JNDI
    -->

    <featureManager>
        <feature>servlet-6.0</feature>
    </featureManager>

    <httpEndpoint id="defaultHttpEndpoint"
                  host="*"
                  httpPort="9080"
                  httpsPort="9443"/>

    <library id="PostgresLib">
        <fileset dir="${shared.resource.dir}/jdbc" includes="postgresql-*.jar"/>
    </library>

    <dataSource id="BayPaySharedDS" jndiName="jdbc/baypay">
        <jdbcDriver libraryRef="PostgresLib"/>
        <properties.postgresql
            serverName="db-east.baypay.example"
            portNumber="5432"
            databaseName="baypay"
            user="baypay_app"
            password="${env.BAYPAY_DB_PASSWORD}"/>
    </dataSource>

    <webApplication id="payment-service"
                    location="payment-service.war"
                    contextRoot="/payment"/>

</server>
